NODE_ENV=development
PORT=5050
BYPASS_AUTH=false

## Logging
LOG_LEVEL=debug

## Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Schema auto-sync: defaults to true in dev, false in production (NODE_ENV).
# Uncomment to force a value for this environment. NEVER set true on prod data.
# DB_SYNCHRONIZE=true

## CORS
CORS_ORIGIN=http://localhost:3000

## JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
ACTOR_TOKEN_EXPIRES_IN=1h
TERMINAL_TOKEN_EXPIRES_IN=24h
