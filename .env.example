NODE_ENV=development
PORT=5050
# Dev-only auth bypass. Requires NODE_ENV=development as well; keep false unless
# you are deliberately working without login.
BYPASS_AUTH=false

## Logging
LOG_LEVEL=debug

## Database
DATABASE_URL=
# Schema auto-sync: defaults to true in dev, false in production (NODE_ENV).
# Uncomment to force a value for this environment. NEVER set true on prod data.
DB_SYNCHRONIZE=true
# Connection pool + query guards. Defaults: max 20, 30s statement timeout.
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

## Seed — SuperAdmin bootstrap (REQUIRED on a fresh database)
# The seed script creates no account without these; there is no default password.
# Startup aborts if they are unset and no SuperAdmin exists yet.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=

## CORS
MAIN_SITE_URL="http://localhost:5173"

## JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=
ACTOR_TOKEN_EXPIRES_IN=
TERMINAL_TOKEN_EXPIRES_IN=
